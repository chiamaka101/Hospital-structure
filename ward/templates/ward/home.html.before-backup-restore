            <span class="text-muted small" style="font-size: 0.75rem;"><i class="bi bi-calendar-check me-1"></i>Today's window</span>
          </div>
          <div class="icon-circle-box bg-warning-subtle text-warning ms-2" style="width: 40px; height: 40px; min-width: 40px;">
            <i class="bi bi-box-arrow-right" style="font-size: 1.1rem;"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Emergency Admits -->
    <div style="min-width: 220px; flex: 1;">
      <div class="card border-0 shadow-sm rounded-4 h-100 hms-card">
        <div class="card-body p-3 d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small fw-medium mb-1">Emergency Admits</p>
            <h2 class="fw-bold mb-1 text-danger">{{ emergency_count|default:0 }}</h2>
            <span class="text-danger small fw-semibold" style="font-size: 0.75rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Critical scale</span>
          </div>
          <div class="icon-circle-box bg-danger-subtle text-danger ms-2" style="width: 40px; height: 40px; min-width: 40px;">
            <i class="bi bi-heart-pulse-fill" style="font-size: 1.1rem;"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Pending Discharge -->
    <div style="min-width: 220px; flex: 1;">
      <div class="card border-0 shadow-sm rounded-4 h-100 hms-card">
        <div class="card-body p-3 d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small fw-medium mb-1">Pending Discharge</p>
            <h2 class="fw-bold mb-1 text-info">{{ pending_discharge|default:0 }}</h2>
            <span class="text-info small fw-semibold" style="font-size: 0.75rem;">Awaiting clearance</span>
          </div>
          <div class="icon-circle-box bg-info-subtle text-info ms-2" style="width: 40px; height: 40px; min-width: 40px;">
            <i class="bi bi-hourglass-split" style="font-size: 1.1rem;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters & Search Bar -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <form method="get" action="{% url 'dashboard' %}" class="row g-2 align-items-center">
        <input type="hidden" name="page" value="admissions">

        <div class="col-md-4">
          <div class="input-group border rounded-3 overflow-hidden">
            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="q" value="{{ request.GET.q }}" class="form-control border-0 ps-0" placeholder="Search patient name, ID, doctor or ward...">
          </div>
        </div>
        <div class="col-md-2">
          <select name="ward" class="form-select border rounded-3">
            <option value="">All Wards Allocation</option>
            {% for w in wards %}
              <option value="{{ w.id }}" {% if request.GET.ward == w.id|stringformat:"s" %}selected{% endif %}>{{ w.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <select name="status" class="form-select border rounded-3">
            <option value="">All Active/Discharged</option>
            <option value="admitted" {% if request.GET.status == 'admitted' %}selected{% endif %}>🟢 Admitted / Active</option>
            <option value="discharged" {% if request.GET.status == 'discharged' %}selected{% endif %}>⚪ Discharged</option>
          </select>
        </div>
        <div class="col-md-2">
          <input type="date" name="start_date" class="form-control border rounded-3" value="{{ request.GET.start_date }}">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Premium Admissions Table Frame -->
  <div class="card border-0 shadow-sm rounded-4 mb-4" style="width: 100%; overflow: hidden;">
    <div class="card-body p-0">
      <div class="table-responsive" style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="table table-hover align-middle mb-0 hms-table" style="min-width: 1100px; table-layout: fixed;">
          <thead>
            <tr class="text-secondary small uppercase text-muted">
              <th class="border-0 ps-4 py-3" style="width: 220px;">Patient Profile</th>
              <th class="border-0 py-3" style="width: 180px;">Ward Allocation</th>
              <th class="border-0 py-3" style="width: 200px;">Attending Practitioner</th>
              <th class="border-0 py-3" style="width: 160px;">Active Diagnosis</th>
              <th class="border-0 py-3" style="width: 160px;">Admission Window</th>
              <th class="border-0 py-3" style="width: 120px;">Live Status</th>
              <th class="border-0 text-end pe-4 py-3" style="width: 140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for admission in admissions %}
              <tr>
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center">
                    <div class="rounded-circle me-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="--avatar-bg: {{ admission.patient.avatar_color|default:'#2563eb' }}; background: var(--avatar-bg); width: 40px; height: 40px; font-size: 0.85rem; min-width: 40px;">
                      {{ admission.patient.name|slice:":2"|upper }}
                    </div>
                    <div class="text-truncate">
                      <div class="fw-bold text-dark mb-0 text-truncate">{{ admission.patient.name }}</div>
                      <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">ID: #{{ admission.patient.id|default:admission.patient_id|default:"N/A" }}</small>
                    </div>
                  </div>
                </td>
                <td class="py-3">
                  <div class="d-flex align-items-center text-truncate">
                    <span class="badge bg-light text-dark border p-2 rounded-3 me-2">
                      <i class="bi bi-building text-primary"></i>
                    </span>
                    <div class="text-truncate">
                      <span class="fw-semibold text-secondary small d-block text-truncate">{{ admission.ward.name|default:"Unassigned Ward" }}</span>
                    </div>
                  </div>
                </td>
                <td class="py-3 text-secondary">
                  <div class="fw-medium text-truncate">
                    {% if admission.doctor %}
                      👨‍⚕️ {{ admission.doctor }}
                    {% else %}
                      <span class="text-warning">Unassigned Duty</span>
                    {% endif %}
                  </div>
                </td>
                <td class="py-3">
                  {% if admission.diagnosis and admission.diagnosis != "" %}
                    <span class="text-truncate d-inline-block fw-medium text-dark w-100" style="max-width: 140px;">{{ admission.diagnosis }}</span>
                  {% elif admission.reason and admission.reason != "" %}
                    <span class="text-truncate d-inline-block fw-medium text-dark w-100" style="max-width: 140px;">{{ admission.reason }}</span>
                  {% else %}
                    <span class="text-muted fst-italic small">No primary diagnosis</span>
                  {% endif %}
                </td>
                <td class="py-3">
                  <div class="fw-medium text-dark small text-nowrap" style="white-space: nowrap;">{{ admission.admission_date|date:"M d, Y" }}</div>
                  <small class="text-muted d-block text-nowrap" style="font-size: 0.75rem; white-space: nowrap;"><i class="bi bi-clock me-1"></i>{{ admission.admission_date|date:"H:i" }}</small>
                </td>
                <td class="py-3">
                  {% if admission.status == 'admitted' %}
                    <span class="badge rounded-pill hms-badge-active px-3 py-2 text-nowrap"><i class="bi bi-circle-fill me-1 small" style="font-size: 7px;"></i> Active</span>
                  {% else %}
                    <span class="badge rounded-pill hms-badge-discharged px-3 py-2 text-nowrap">Discharged</span>
                  {% endif %}
                </td>
                <td class="text-end pe-4 py-3">
                  <div class="d-inline-flex gap-2 justify-content-end align-items-center w-100">
                    <!-- View Button -->
                    <button type="button" class="btn btn-sm btn-light hms-action-btn text-primary border m-0" data-bs-toggle="modal" data-bs-target="#viewModal{{ admission.id }}" title="View System Record">
                      <i class="bi bi-eye-fill"></i>
                    </button>

                    <!-- Edit Button -->
                    {% if request.user.profile.role == 'receptionist' %}
                      <button type="button" class="btn btn-sm btn-light hms-action-btn text-success border m-0" data-bs-toggle="modal" data-bs-target="#editModal{{ admission.id }}" title="Modify Admissions Context">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                    {% endif %}

                    <!-- Discharge Button -->
                    {% if admission.status == 'admitted' and request.user.profile.role == 'receptionist' %}
                      <form method="POST" action="{% url 'dashboard' %}?page=admissions" class="m-0 p-0" style="display: inline;">
                        {% csrf_token %}
                        <input type="hidden" name="discharge_id" value="{{ admission.id }}">
                        <button type="submit" name="discharge" class="btn btn-sm btn-light hms-action-btn text-danger border m-0" title="Trigger Discharge Process">
                          <i class="bi bi-box-arrow-right"></i>
                        </button>
                      </form>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% empty %}
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-folder-x d-block mb-2 text-muted" style="font-size: 2.5rem;"></i>
                  No active records match the provided query data.
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Bottom Analytics Widgets -->
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0 text-dark">Recent Admissions Activity</h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill small">Real-time</span>
          </div>
          {% for adm in recent_admissions|slice:":3" %}
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-light">
              <div class="d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="--avatar-bg: {{ adm.patient.avatar_color|default:'#a78bfa' }}; background: var(--avatar-bg); width: 36px; height: 36px; font-size: 0.75rem;">
                  {{ adm.patient.name|slice:":2"|upper }}
                </div>
                <div>
                  <div class="fw-bold small text-dark mb-0">{{ adm.patient.name }}</div>
                  <small class="text-muted d-block" style="font-size: 0.75rem;">Allocated: {{ adm.ward.name }}</small>
                </div>
              </div>
              <small class="text-muted bg-light border px-2 py-1 rounded-3" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>{{ adm.admission_date|timesince }} ago</small>
            </div>
          {% empty %}
            <div class="text-center py-4 text-muted small">No records registered recently.</div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3 text-dark">Live Admissions by Ward Capacity</h6>
          {% if ward_stats %}
            {% for w in ward_stats %}
              <div class="mb-3">
                <div class="d-flex justify-content-between mb-1 align-items-center">
                  <small class="fw-bold text-secondary">{{ w.ward__name|default:"Unknown Department" }}</small>
                  <small class="badge bg-light text-dark border fw-medium">{{ w.count }} patients ({{ w.percent }}%)</small>
                </div>
                <div class="progress rounded-pill shadow-inner" style="height: 8px;">
                  <div class="progress-bar bg-primary rounded-pill" style="--bar-width: {{ w.percent }}%; width: var(--bar-width);"></div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="text-center py-4 text-muted small">No functional metrics logged yet.</div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white position-relative overflow-hidden">
        <div class="position-absolute end-0 bottom-0 text-white-50 opacity-10" style="font-size: 10rem; transform: translate(20px, 40px);">
          <i class="bi bi-heart-pulse"></i>
        </div>
        <div class="card-body p-4 z-1 position-relative d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold mb-0 text-white">Today's Summary Panel</h6>
              <span class="badge bg-success rounded-pill px-2 py-1" style="font-size: 0.65rem;">Active Facility</span>
            </div>
            <p class="text-white-50 small mb-4">A snapshot of structural throughput across critical components today.</p>

            <div class="row g-2 mb-2">
              <div class="col-6">
                <div class="bg-white bg-opacity-10 p-3 rounded-3 text-center">
                  <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">Intake Shift</small>
                  <span class="fw-bold text-white fs-5">Morning</span>
                </div>
              </div>
              <div class="col-6">
                <div class="bg-white bg-opacity-10 p-3 rounded-3 text-center">
                  <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">Bed Occupancy</small>
                  <span class="fw-bold text-success fs-5">10%</span>
                </div>
              </div>
            </div>
          </div>

          <button class="btn btn-outline-light w-100 btn-sm mt-3 border-white-50 py-2 rounded-3 text-white fw-medium" data-bs-toggle="modal" data-bs-target="#admitPatientModal">
            <i class="bi bi-hospital me-1"></i> Quick Admission Pipeline Entry
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODALS PLACED OUTSIDE THE TABLE STRUCTURE   -->
<!-- ========================================== -->

{% for admission in admissions %}
  <!-- View Modal -->
  <div class="modal fade" id="viewModal{{ admission.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">

        <!-- Header -->
        <div class="modal-header border-0 text-white p-4" style="background: linear-gradient(135deg, #2563eb, #1e40af);">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 55px; height: 55px; font-size: 20px; font-weight: 700; min-width: 55px;">
              {{ admission.patient.name|slice:":2"|upper }}
            </div>

            <div>
              <h4 class="mb-0 fw-bold tracking-tight">
                {{ admission.patient.name }}
              </h4>
              <span class="badge bg-white bg-opacity-25 text-white fw-light mt-1">
                <i class="bi bi-file-earmark-medical me-1"></i> Admission Ledger
              </span>
            </div>
          </div>

          <button class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Body (Scrollable for safety) -->
        <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">

          <!-- Status & Identification Section -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="bg-light rounded-4 p-3 border-0">
                <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                  Patient File ID
                </small>
                <h6 class="fw-bold mb-0 text-dark">
                  <i class="bi bi-hash text-muted"></i>{{ admission.patient.patient_id|default:admission.patient.id }}
                </h6>
              </div>
            </div>

            <div class="col-md-6">
              <div class="bg-light rounded-4 p-3 border-0">
                <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                  Admission Status
                </small>
                {% if admission.status == 'admitted' %}
                  <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 mt-1">
                    <span class="spinner-grow spinner-grow-sm me-1" role="status" aria-hidden="true" style="width: 8px; height: 8px;"></span>
                    Active / Admitted
                  </span>
                {% else %}
                  <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 mt-1">
                    <i class="bi bi-check-lg me-1"></i> Discharged
                  </span>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Assignment Details Section -->
          <h6 class="fw-bold text-secondary mb-3 fs-6">Placement & Staff</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="border rounded-4 p-3 h-100">
                <small class="text-muted d-block mb-1">Assigned Ward</small>
                <h6 class="fw-bold mt-1 mb-0 text-dark">
                  <i class="bi bi-hospital text-primary me-2"></i>
                  {{ admission.ward.name }}
                </h6>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded-4 p-3 h-100">
                <small class="text-muted d-block mb-1">Attending Physician</small>
                <h6 class="fw-bold mt-1 mb-0 text-dark">
                  <i class="bi bi-person-badge text-success me-2"></i>
                  {% if admission.doctor %}
                    Dr. {{ admission.doctor.profile.user.get_full_name }}
                  {% else %}
                    <span class="text-muted fw-normal">Not Assigned</span>
                  {% endif %}
                </h6>
              </div>
            </div>
          </div>

          <!-- Timeline Section -->
          <h6 class="fw-bold text-secondary mb-3 fs-6">Timeline Events</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="border rounded-4 p-3 h-100">
                <small class="text-muted d-block mb-1">Admitted On</small>
                <h6 class="fw-bold mt-1 mb-0 text-dark">
                  <i class="bi bi-calendar-event text-muted me-2"></i>
                  {{ admission.admission_date|date:"F d, Y" }}
                </h6>
                <small class="text-muted mt-1 d-block">
                  <i class="bi bi-clock me-1"></i>{{ admission.admission_date|date:"h:i A" }}
                </small>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded-4 p-3 h-100">
                <small class="text-muted d-block mb-1">Discharged On</small>
                <h6 class="fw-bold mt-1 mb-0 text-dark">
                  <i class="bi bi-calendar-check text-muted me-2"></i>
                  {% if admission.discharge_date %}
                    {{ admission.discharge_date|date:"F d, Y" }}
                  {% else %}
                    <span class="text-muted fw-normal">N/A (Active Stay)</span>
                  {% endif %}
                </h6>
                {% if admission.discharge_date %}
                  <small class="text-muted mt-1 d-block">
                    <i class="bi bi-clock me-1"></i>{{ admission.discharge_date|date:"h:i A" }}
                  </small>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Diagnosis & Reason Section -->
          <div class="row">
            <div class="col-12">
              <div class="border rounded-4 p-4 bg-light">
                <small class="text-uppercase text-muted fw-bold d-block mb-2" style="font-size: 11px; letter-spacing: 0.5px;">
                  Medical Reason & Notes
                </small>
                <div class="fw-medium text-dark lh-base fs-6" style="white-space: pre-wrap;">
                  {% if admission.diagnosis %}
                    {{ admission.diagnosis }}
                  {% elif admission.reason %}
                    {{ admission.reason }}
                  {% endif %}
                </div>

                {% if admission.notes %}
                  <hr class="my-3 text-muted opacity-25">
                  <small class="text-muted fw-bold d-block mb-1" style="font-size: 11px;">ADDITIONAL REMARKS</small>
                  <p class="text-secondary small mb-0">{{ admission.notes }}</p>
                {% endif %}
              </div>
            </div>
          </div>

        </div>

        <!-- Footer -->
        <div class="modal-footer border-0 bg-light p-3">
          <button class="btn btn-secondary px-4 py-2 rounded-3 text-white fw-semibold" style="background-color: #64748b; border: none;" data-bs-dismiss="modal">
            Close Details
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  {% if request.user.profile.role == 'receptionist' %}
    <div class="modal fade" id="editModal{{ admission.id }}" tabindex="-1" aria-labelledby="editModalLabel{{ admission.id }}" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" action="{% url 'dashboard' %}?page=admissions">
          {% csrf_token %}
          <input type="hidden" name="edit_id" value="{{ admission.id }}">
          <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light rounded-top-4 border-0">
              <h5 class="modal-title fw-bold text-dark" id="editModalLabel{{ admission.id }}"><i class="bi bi-pencil-square text-success me-2"></i>Edit Admission Log</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold text-secondary small">Reallocate Ward</label>
                  <select name="ward" class="form-select border rounded-3">
                    {% for w in wards %}
                      <option value="{{ w.id }}" {% if w.id == admission.ward.id %}selected{% endif %}>{{ w.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold text-secondary small">Change Lead Practitioner</label>
                  <select name="doctor" class="form-select border rounded-3">
                    {% for d in doctors %}
                      <option value="{{ d.id }}" {% if d.id == admission.doctor.id %}selected{% endif %}>{{ d }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold text-secondary small">Update Active Diagnosis / Reasoning</label>
                  <textarea name="diagnosis" class="form-control border rounded-3" rows="3">{% if admission.diagnosis %}{{ admission.diagnosis }}{% else %}{{ admission.reason|default:"" }}{% endif %}</textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer border-0">
              <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success px-4">Save Changes</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  {% endif %}
{% endfor %}

<!-- Premium Admit Patient Modal (New Admissions) -->
<div class="modal fade" id="admitPatientModal" tabindex="-1" aria-labelledby="admitPatientModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form method="post" action="{% url 'dashboard' %}?page=admissions">
      {% csrf_token %}
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header bg-primary text-white rounded-top-4 border-0 p-3">
          <h5 class="modal-title fw-bold d-flex align-items-center" id="admitPatientModalLabel">
            <i class="bi bi-person-plus-fill me-2"></i> Register New Patient Intake Admission
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
