                    <label class="fw-semibold text-secondary mb-1">Rx Details</label>
                    <div class="border rounded p-2 bg-light mb-3 font-monospace" style="font-size: 11px; white-space: pre-line;">{{ presc.prescription_text|default:"See medical file notes." }}</div>

