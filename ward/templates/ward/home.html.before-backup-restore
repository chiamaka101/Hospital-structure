                                </td>
                                <td class="py-2.5 small text-secondary">
                                    {{ item.category|default:"General" }}
                                </td>
                                <td class="py-2.5 small fw-medium text-dark">
                                    {{ item.quantity_in_stock }} Units
                                </td>
                                <td class="py-2.5 small fw-semibold text-dark">
                                    ₦{{ item.price|floatformat:2 }}
                                </td>
                                <td class="py-2.5 small text-muted">
                                    {{ item.expiry_date|date:"d M Y" }}
                                </td>
                                <td class="py-2.5">
                                    {% if item.quantity_in_stock == 0 %}
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-2 px-2 py-1" style="font-size: 10px;">Out of Stock</span>
                                    {% elif item.quantity_in_stock <= 15 %}
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-2 px-2 py-1 text-dark fw-medium" style="font-size: 10px;">Low Stock</span>
                                    {% else %}
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-2 px-2 py-1 fw-medium" style="font-size: 10px;">In Stock</span>
                                    {% endif %}
                                </td>
                                <td class="py-2.5 text-end px-3">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-light border p-1 d-inline-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" data-bs-toggle="modal" data-bs-target="#viewMedicine{{ item.id }}" title="View"><i class="bi bi-eye text-primary small"></i></button>
                                        <button class="btn btn-sm btn-light border p-1 d-inline-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" data-bs-toggle="modal" data-bs-target="#editMedicineModal{{ item.id }}" title="Edit"><i class="bi bi-pencil text-success small"></i></button>
                                        <button class="btn btn-sm btn-light border p-1 d-inline-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" data-bs-toggle="modal" data-bs-target="#deleteMedicineModal{{ item.id }}" title="Delete"><i class="bi bi-trash text-danger small"></i></button>
                                    </div>
                                </td>
                            </tr>
                            {% empty %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted small">No medications found.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Side: Side Analytics & Alerts -->
        <div class="col-lg-4">

            <!-- Refill Priority List -->
            <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-3">
                    <h6 class="fw-bold text-danger mb-0 d-flex align-items-center small">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Refill Priority List
                    </h6>
                </div>
                <div class="card-body p-2">
                    {% for alert in low_stock_medicines %}
                        <div class="d-flex justify-content-between align-items-center border border-light-subtle rounded-2 p-2 mb-1.5 bg-light-subtle">
                            <span class="fw-medium text-dark small">{{ alert.name }}</span>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-2 fw-semibold" style="font-size: 10px;">{{ alert.quantity_in_stock }} left</span>
                        </div>
                    {% empty %}
                        <div class="text-center py-3 text-muted small"><i class="bi bi-check2-circle text-success me-1"></i> Stock margins healthy.</div>
                    {% endfor %}
                </div>
            </div>

            <!-- Approaching Expirations -->
            <div class="card border border-light-subtle shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center small">
                        <i class="bi bi-calendar2-x-fill text-secondary me-2"></i> Expiring Stock (90 Days)
                    </h6>
                </div>
                <div class="card-body p-2">
                    {% for item in expiring_medicines %}
                        <div class="d-flex justify-content-between align-items-center border border-light-subtle rounded-2 p-2 mb-1.5 bg-light-subtle">
                            <div>
                                <span class="fw-medium text-dark d-block small mb-0">{{ item.name }}</span>
                                <small class="text-muted" style="font-size: 10px;">Exp: {{ item.expiry_date|date:"d M Y" }}</small>
                            </div>
                            <span class="badge bg-light text-secondary border rounded-2" style="font-size: 10px;">#{{ item.batch_number|default:"N/A" }}</span>
                        </div>
                    {% empty %}
                        <div class="text-center py-3 text-muted small"><i class="bi bi-shield-check text-success me-1"></i> No upcoming expirations.</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

{% for presc in pending_prescriptions %}
<div class="modal fade" id="dispenseModal{{ presc.id }}" tabindex="-1" aria-hidden="true">
