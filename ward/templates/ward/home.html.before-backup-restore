{% elif page == 'patients' %}
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
        <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-people-fill"></i>
        </span>
        Patients
      </h2>
      <p class="text-muted mb-0">Manage and monitor all registered patients efficiently.</p>
    </div>
  </div>

  <!-- SEARCH + FILTER + ADD BUTTON -->
  <form method="GET" class="d-flex align-items-center gap-2 mb-4 flex-wrap flex-lg-nowrap">
    <input type="hidden" name="page" value="patients">
    
    <div class="input-group shadow-sm flex-grow-1" style="min-width: 280px;">
      <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
      <input type="text" name="search" value="{{ request.GET.search }}" class="form-control border-0 bg-light" placeholder="Search patients...">
    </div>
    
    <select name="gender" class="form-select border-0 bg-light shadow-sm" style="width: 160px; min-width: 160px;">
      <option value="">All Gender</option>
      <option value="Male" {% if request.GET.gender == 'Male' %}selected{% endif %}>Male</option>
      <option value="Female" {% if request.GET.gender == 'Female' %}selected{% endif %}>Female</option>
    </select>
    
    <button type="submit" class="btn btn-primary shadow-sm px-4" style="white-space: nowrap;">
      <i class="bi bi-funnel-fill me-1"></i>Filter
    </button>
    
    <a href="{% url 'dashboard' %}?page=patients" class="btn btn-light border shadow-sm px-3" style="white-space: nowrap;">
      <i class="bi bi-arrow-clockwise"></i>
    </a>
    
    {% if role == 'receptionist' %}
      <button type="button" class="btn btn-primary px-4 py-2 shadow-sm ms-lg-auto" data-bs-toggle="modal" data-bs-target="#addPatientModal" style="white-space: nowrap;">
        <i class="bi bi-person-plus-fill me-2"></i>Add Patient
      </button>
    {% endif %}
  </form>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="fw-semibold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>Patient Records</h5>
        <small class="text-muted">Total Registered Patients: <span class="fw-semibold text-dark">{{ patients.paginator.count }}</span></small>
      </div>
      <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2"><i class="bi bi-database-fill me-1"></i>Live Records</span>
    </div>
    
    <div class="card-body p-4">
      {% if patients %}
        <div class="table-responsive">
          <table class="table align-middle table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="fw-semibold" style="width: 40px;">#</th>
                <th class="fw-semibold">Patient ID</th>
                <th class="fw-semibold">Patient Name</th>
                <th class="fw-semibold">Age</th>
                <th class="fw-semibold">Gender</th>
                <th class="fw-semibold">Contact</th>
                <th class="fw-semibold">Registered</th>
                <th class="fw-semibold text-center" style="width: 160px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for p in patients %}
                <tr>
                  <td>{{ forloop.counter }}</td>
                  <td><span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">{{ p.patient_id }}</span></td>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width:45px;height:45px;min-width:45px;">
                        {{ p.name|slice:":1"|upper }}
                      </div>
                      <div>
                        <h6 class="mb-0 fw-semibold text-capitalize">{{ p.name }}</h6>
                        <small class="text-muted">Patient Record</small>
                      </div>
                    </div>
                  </td>
                  <td>{{ p.age|default:"-" }}</td>
                  <td>
                    {% if p.gender == 'Male' %}
                      <span class="badge bg-info-subtle text-info px-3 py-2"><i class="bi bi-gender-male me-1"></i>Male</span>
                    {% elif p.gender == 'Female' %}
                      <span class="badge bg-danger-subtle text-danger px-3 py-2"><i class="bi bi-gender-female me-1"></i>Female</span>
                    {% else %}
                      <span class="badge bg-secondary-subtle text-secondary px-3 py-2">{{ p.gender|default:"-" }}</span>
                    {% endif %}
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-telephone-fill text-success"></i>
                      <span>{{ p.contact|default:"-" }}</span>
                    </div>
                  </td>
                  <td>
                    <div>
                      <span class="fw-medium">{{ p.created_at|date:"M d, Y" }}</span><br>
                      <small class="text-muted">{{ p.created_at|timesince }} ago</small>
                    </div>
                  </td>
                  <td class="text-center">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                      <!-- View -->
                      <button type="button"
                              class="btn btn-info btn-sm text-white"
                              data-bs-toggle="modal"
                              data-bs-target="#viewPatientModal{{ p.id }}">
                        <i class="bi bi-eye-fill me-1"></i> View
                      </button>

                      <!-- Edit -->
                      <a href="{% url 'edit_patient' p.id %}"
                         class="btn btn-warning btn-sm text-white">
                        <i class="bi bi-pencil-square me-1"></i>Edit
                      </a>

                      <!-- Delete -->
                      <form method="POST" action="{% url 'delete_patient' p.id %}" class="m-0">
                        {% csrf_token %}
                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete {{ p.name }}?');">
                          <i class="bi bi-trash-fill me-1"></i>Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        
        <!-- PAGINATION -->
        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
          <div class="text-muted small">Showing page {{ patients.number }} of {{ patients.paginator.num_pages }}</div>
          <nav>
            <ul class="pagination mb-0">
              {% if patients.has_previous %}
