                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No laboratory test requests found.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center text-muted fs-7">
