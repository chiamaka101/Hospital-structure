                          <small class="text-muted">currently admitted</small>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-box h-100">
                        <div class="info-icon warning"><i class="bi bi-receipt"></i></div>
                        <div class="flex-grow-1">
                          <small class="text-muted d-block">Pending bills</small>
                          <h4 class="fw-bold mb-0">₦{{ outstanding_bills|default:3000|intcomma }}</h4>
