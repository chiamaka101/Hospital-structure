                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- Bottom Columns: Patient Activity & Billing Split -->
              <div class="row g-4">
                <div class="col-md-6">
                  <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <h6 class="mb-0"><i class="bi bi-people me-2" style="color: var(--primary);"></i>Recent Patients</h6>
                      <a href="{% url 'dashboard' %}?page=patients" class="small text-decoration-none" style="color: var(--primary);">View all →</a>
                    </div>
                    <div class="card-body">
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th class="border-0 small text-muted">Patient</th>
                            <th class="border-0 small text-muted">ID</th>
                            <th class="border-0 small text-muted">Time</th>
                            <th class="border-0 small text-muted">Action</th>
                          </tr>
                        </thead>
                        <tbody>
                          {% for patient in recent_patients|slice:":5" %}
                          <tr>
                            <td class="fw-semibold">{{ patient.name|title }}</td>
                            <td><span class="badge rounded-pill" style="background: rgba(148,163,184,0.12); color: var(--muted);">{{ patient.patient_id }}</span></td>
                            <td class="text-muted">{{ patient.created_at|time:"g:i A" }}</td>
                            <td><a href="{% url 'dashboard' %}?page=patient_detail&id={{ patient.id }}" class="btn btn-sm btn-outline-primary rounded-3">View</a></td>
                          </tr>
                          {% empty %}
                          <tr><td colspan="4" class="text-center text-muted py-4"><i class="bi bi-people fs-2 d-block mb-2 opacity-25"></i>No patients registered today</td></tr>
                          {% endfor %}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
                
                <div class="col-md-6">
                  <div class="card h-100">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-receipt me-2" style="color: var(--primary);"></i>Billing Summary</h6></div>
                    <div class="card-body">
                      <div class="row g-2">
                        <div class="col-12">
                          <div class="info-box p-2 d-flex justify-content-between align-items-center" style="background: rgba(22,163,74,0.05);">
                            <small class="text-muted">Today's Payments</small>
                            <h5 class="fw-bold mb-0" style="color: var(--success);">₦{{ todays_payments|default:0|intcomma }}</h5>
                          </div>
                        </div>
                        <div class="col-12">
                          <div class="info-box p-2 d-flex justify-content-between align-items-center" style="background: rgba(245,158,11,0.05);">
                            <small class="text-muted">Outstanding</small>
                            <h5 class="fw-bold mb-0" style="color: var(--warning);">₦{{ outstanding_bills|default:3000|intcomma }}</h5>
                          </div>
                        </div>
                        <div class="col-12">
                          <div class="info-box p-2 d-flex justify-content-between align-items-center" style="background: rgba(239,68,68,0.05);">
                            <small class="text-muted">Pending Invoices</small>
                            <h5 class="fw-bold mb-0" style="color: var(--danger);">{{ pending_invoices|default:1 }}</h5>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column (4/12 Width) -->
            <div class="col-lg-4">
              <!-- Notifications Card -->
              <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h6 class="mb-0"><i class="bi bi-bell me-2" style="color: #2563eb;"></i>Notifications</h6>
                  <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Mark all read</button>
                </div>
                <div class="card-body notification-body">
                  {% for notif in notifications|slice:":5" %}
                  <div class="notification-item {% if notif.is_read %}unread{% endif %} d-flex align-items-start mb-3 pb-3 border-bottom">
                    
                    {% if 'unpaid' in notif.message|lower or 'bill' in notif.message|lower or 'invoice' in notif.message|lower %}
                      <div class="notification-icon rounded-circle me-3" style="width:42px;height:42px;background: rgba(245,158,11,0.18);display:flex;align-items:center;justify-content:center;flex-shrink: 0;">
                        <i class="bi bi-receipt" style="color: #f59e0b;font-size:1.2rem;"></i>
                      </div>
                    {% elif 'appointment' in notif.message|lower or 'schedule' in notif.message|lower %}
                      <div class="notification-icon rounded-circle me-3" style="width:42px;height:42px;background: rgba(37,99,235,0.18);display:flex;align-items:center;justify-content:center;flex-shrink: 0;">
                        <i class="bi bi-calendar-event" style="color: #2563eb;font-size:1.2rem;"></i>
                      </div>
                    {% elif 'registered' in notif.message|lower or 'patient' in notif.message|lower or 'admitted' in notif.message|lower %}
                      <div class="notification-icon rounded-circle me-3" style="width:42px;height:42px;background: rgba(22,163,74,0.18);display:flex;align-items:center;justify-content:center;flex-shrink: 0;">
                        <i class="bi bi-person-plus-fill" style="color: #16a34a;font-size:1.2rem;"></i>
                      </div>
                    {% elif 'warning' in notif.message|lower or 'alert' in notif.message|lower or 'failed' in notif.message|lower %}
                      <div class="notification-icon rounded-circle me-3" style="width:42px;height:42px;background: rgba(239,68,68,0.18);display:flex;align-items:center;justify-content:center;flex-shrink: 0;">
                        <i class="bi bi-exclamation-triangle-fill" style="color: #ef4444;font-size:1.2rem;"></i>
                      </div>
                    {% else %}
                      <div class="notification-icon rounded-circle me-3" style="width:42px;height:42px;background: rgba(37,99,235,0.18);display:flex;align-items:center;justify-content:center;flex-shrink: 0;">
                        <i class="bi bi-bell-fill" style="color: #2563eb;font-size:1.2rem;"></i>
                      </div>
                    {% endif %}
                    
                    <div class="flex-grow-1 text-truncate">
                      <div class="fw-semibold small mb-1 text-wrap">{{ notif.message }}</div>
                      <small class="text-muted" style="font-size:0.78rem;">{{ notif.created_at|timesince }} ago</small>
                    </div>
                  </div>
                  {% empty %}
                  <div class="text-center text-muted py-5">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:70px;height:70px;border-radius:50%;background:#f1f5f9;">
                      <i class="bi bi-bell-slash" style="font-size:2rem;color:#94a3b8;"></i>
                    </div>
                    <p class="mb-0 small">No new notifications</p>
                  </div>
                  {% endfor %}
                  
                  <a href="{% url 'dashboard' %}?page=notifications" class="d-block text-center small mt-3 fw-medium text-decoration-none" style="color: #2563eb;">
                    View all notifications →
                  </a>
                </div>
              </div>

              <!-- Operations Card Inside Dashboard View -->
              <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h6 class="mb-0"><i class="bi bi-list-task me-2" style="color: var(--primary);"></i>Today's Operations</h6>
                  <span class="badge" style="background: rgba(245,158,11,0.12); color: var(--warning); padding: 0.35em 0.65em;">3 tasks</span>
                </div>
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                    <div class="d-flex">
                      <div class="info-icon danger me-3"><i class="bi bi-currency-dollar"></i></div>
                      <div>
                        <div class="fw-semibold small">Follow up pending payment <span class="badge ms-1" style="background: rgba(239,68,68,0.12); color: var(--danger);">High</span></div>
                        <small class="text-muted">Invoice balance: ₦{{ outstanding_bills|default:3000|intcomma }}</small>
                      </div>
                    </div>
                    <a href="{% url 'dashboard' %}?page=invoices" class="btn btn-sm btn-outline-danger rounded-pill px-3">Open</a>
                  </div>
                  <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                    <div class="d-flex">
                      <div class="info-icon warning me-3"><i class="bi bi-telephone"></i></div>
                      <div>
                        <div class="fw-semibold small">Confirm tomorrow's appointments <span class="badge ms-1" style="background: rgba(245,158,11,0.12); color: var(--warning);">Medium</span></div>
                        <small class="text-muted">Send reminders before 6 PM.</small>
                      </div>
                    </div>
                    <a href="{% url 'dashboard' %}?page=appointments" class="btn btn-sm btn-outline-warning rounded-pill px-3">Review</a>
                  </div>
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex">
                      <div class="info-icon success me-3"><i class="bi bi-heart-pulse-fill"></i></div>
                      <div>
                        <div class="fw-semibold small">Review active admissions <span class="badge ms-1" style="background: rgba(22,163,74,0.12); color: var(--success);">{{ current_admissions|default:2 }} active</span></div>
                        <small class="text-muted">Verify ward status and discharge plans.</small>
                      </div>
                    </div>
                    <a href="{% url 'dashboard' %}?page=admissions" class="btn btn-sm btn-outline-success rounded-pill px-3">View</a>
                  </div>
                  <a href="{% url 'dashboard' %}?page=tasks" class="d-block text-center small mt-3 text-decoration-none" style="color: var(--primary);">View all tasks →</a>
                </div>
              </div>

            </div> <!-- End Right Column -->
          </div> <!-- End Main row Layout -->
        </div> <!-- End Dashboard View -->
    {% endif %}

