                      <div class="flex-shrink-0 text-center" style="width: 90px;">
                        <div class="fw-bold" style="font-size: 1.15rem; line-height: 1.2; color: var(--primary);">{{ apt.date_time|time:"g:i" }}</div>
                        <small class="text-muted" style="font-size: 0.75rem;">{{ apt.date_time|date:"M d" }}</small>
                      </div>
                      <div class="flex-grow-1 text-truncate" style="white-space: nowrap;">
                        <span class="fw-semibold">{{ apt.patient.name|title }}</span>
