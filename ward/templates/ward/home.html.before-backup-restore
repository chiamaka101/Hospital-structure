                      <div class="info-box h-100">
                        <div class="info-icon" style="background: rgba(139,92,246,0.12);"><i class="bi bi-person-plus" style="color: #8b5cf6;"></i></div>
                        <div class="flex-grow-1">
                          <small class="text-muted d-block">New patients</small>
                          <h4 class="fw-bold mb-0">{{ new_patients_today|default:0 }}</h4>
