                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="bg-light text-secondary small" style="font-size: 11px;">
                                <th class="border-bottom px-3 py-2 text-uppercase fw-bold">Medication Name</th>
                                <th class="border-bottom py-2 text-uppercase fw-bold">Category</th>
                                <th class="border-bottom py-2 text-uppercase fw-bold">Stock</th>
                                <th class="border-bottom py-2 text-uppercase fw-bold">Retail Price</th>
                                <th class="border-bottom py-2 text-uppercase fw-bold">Exp. Date</th>
                                <th class="border-bottom py-2 text-uppercase fw-bold">Status</th>
