{% if role == 'Receptionist' %}
<div class="modal fade" id="admitPatientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Admit Patient</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="{% url 'admit_patient' %}">
        {% csrf_token %}
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Patient</label>
              {{ admission_form.patient }}
              <div class="text-danger small">{{ admission_form.patient.errors }}</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Ward</label>
              {{ admission_form.ward }}
              <div class="text-danger small">{{ admission_form.ward.errors }}</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Doctor</label>
              {{ admission_form.doctor }}
              <div class="text-danger small">{{ admission_form.doctor.errors }}</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Admission Date</label>
              {{ admission_form.admission_date }}
              <div class="text-danger small">{{ admission_form.admission_date.errors }}</div>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Reason</label>
              {{ admission_form.reason }}
              <div class="text-danger small">{{ admission_form.reason.errors }}</div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Admit Patient</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endif %}

<!-- Add Medical Record Modal - Doctor only -->
{% if role == 'doctor' %}
<div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" action="{% url 'add_medical_record' %}" enctype="multipart/form-data">
        {% csrf_token %}
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addRecordModalLabel">Add Medical Record</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          {% if record_form.errors %}
            <div class="alert alert-danger">Please fix the errors below.</div>
          {% endif %}
          <div class="row g-3">
           <div class="col-md-6">
  <label class="form-label fw-bold">Patient *</label>
  {{ record_form.patient }}
  {% if record_form.patient.errors %}<div class="text-danger small">{{ record_form.patient.errors.0 }}</div>{% endif %}
</div>
<div class="col-md-6">
  <label class="form-label fw-bold">Record Type *</label>
  {{ record_form.record_type }}
  {% if record_form.record_type.errors %}<div class="text-danger small">{{ record_form.record_type.errors.0 }}</div>{% endif %}
</div>
<div class="col-12">
  <label class="form-label fw-bold">Diagnosis *</label>
  {{ record_form.diagnosis }}
  {% if record_form.diagnosis.errors %}<div class="text-danger small">{{ record_form.diagnosis.errors.0 }}</div>{% endif %}
</div>
<div class="col-12">
  <label class="form-label fw-bold">Prescription</label>
  {{ record_form.prescription }}
  {% if record_form.prescription.errors %}<div class="text-danger small">{{ record_form.prescription.errors.0 }}</div>{% endif %}
</div>
<div class="col-12">
  <label class="form-label fw-bold">Treatment / Notes</label>
  {{ record_form.notes }}
  {% if record_form.notes.errors %}<div class="text-danger small">{{ record_form.notes.errors.0 }}</div>{% endif %}
</div>
<div class="col-12">
  <label class="form-label fw-bold">Attachment</label>
  {{ record_form.files }}
  <div class="form-text">PDF, JPG, PNG, DOCX allowed. Max 5MB</div>
  {% if record_form.files.errors %}<div class="text-danger small">{{ record_form.files.errors.0 }}</div>{% endif %}
</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Record</button>
        </div>
      </form>
    </div>
  </div>
</div>





{% endif %}
<!-- ADD APPOINTMENT MODAL -->
<div class="modal fade" id="addAppointmentModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
      <div class="modal-header bg-success text-white border-0 py-3 px-4">
        <h5 class="modal-title fw-bold d-flex align-items-center gap-2"><i class="bi bi-calendar-plus-fill"></i>Book Appointment</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form method="POST" action="{% url 'create_appointment' %}">{% csrf_token %}
          <div class="mb-3">{{ appointment_form.as_p }}</div>
          <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-semibold"><i class="bi bi-check2-circle me-2"></i>Confirm Appointment</button>
        </form>
      </div>
    </div>
  </div>
</div>


<!-- ADD PATIENT MODAL -->
<div class="modal fade" id="addPatientModal" tabindex="-1" aria-labelledby="addPatientModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-semibold" id="addPatientModalLabel">
          <i class="bi bi-person-plus-fill me-2"></i>Register New Patient
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="{% url 'add_patient' %}">
        {% csrf_token %}
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Patient Name</label>
              {{ patient_form.name }}
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Age</label>
              {{ patient_form.age }}
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Gender</label>
              {{ patient_form.gender }}
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Contact</label>
              {{ patient_form.contact }}
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Address</label>
              {{ patient_form.address }}
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-circle-fill me-1"></i>Save Patient
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<!-- Toast Container  -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
  {% if messages %}
    {% for message in messages %}
      <div class="toast align-items-center text-white bg-{{ message.tags|default:'success' }} border-0 shadow auto-toast" 
           role="alert" 
           aria-live="assertive" 
           aria-atomic="true" 
           data-bs-autohide="true" 
           data-bs-delay="3000"> 
        
        <div class="d-flex">
          <div class="toast-body d-flex align-items-center gap-2">
            {% if message.tags == 'success' %}
              <i class="bi bi-check-circle-fill fs-5"></i>
            {% elif message.tags == 'error' or message.tags == 'danger' %}
              <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            {% else %}
              <i class="bi bi-info-circle-fill fs-5"></i>
            {% endif %}
            <span>{{ message }}</span>
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>

      </div>
    {% endfor %}
  {% endif %}
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
  const sidebar = document.getElementById('sidebar');
  const content = document.getElementById('content');
  const toggleBtn = document.getElementById('sidebarToggle');

  toggleBtn.addEventListener('click', () => {
    if (window.innerWidth <= 992) {
      sidebar.classList.toggle('active');
    } else {
      sidebar.classList.toggle('collapsed');
      content.classList.toggle('expanded');
    }
  });

  if (window.innerWidth <= 992) {
    sidebar.classList.remove('active');
  }

  
  // Wait for the DOM to fully load
  document.addEventListener('DOMContentLoaded', function () {
    // Select all alert elements (like the success message banner)
    const alerts = document.querySelectorAll('.alert');

    alerts.forEach(function (alert) {
      setTimeout(function () {
        
        alert.style.transition = 'opacity 0.5s ease';
        alert.style.opacity = '0';

        
        setTimeout(function () {
          alert.remove();
        }, 500);
      }, 3000); // 3000ms = 3 seconds
    });
  });

</script>
</body>
</html>