<!-- Client-side Javascript search and status filter -->
<script>
function filterLabTable() {
    let input = document.getElementById("labSearch").value.toLowerCase();
    let statusFilter = document.getElementById("labStatusFilter").value.toLowerCase();
    let rows = document.querySelectorAll(".lab-row");

    rows.forEach(row => {
        let text = row.innerText.toLowerCase();
        let status = row.getAttribute("data-status").toLowerCase();
        
        let matchesSearch = text.includes(input);
        let matchesStatus = statusFilter === "" || status === statusFilter;

        if (matchesSearch && matchesStatus) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}
</script>




