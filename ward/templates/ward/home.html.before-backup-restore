{% load static humanize %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Lifespring Medical Center{% endblock %}</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --primary: #2563eb;
  --primary-light: #3b82f6;
  --primary-dark: #1d4ed8;
  --sidebar-bg: #0f172a;
  --sidebar-bg-2: #111827;
  --sidebar-hover: rgba(255, 255, 255, 0.08);
  --sidebar-active: linear-gradient(135deg, #2563eb, #3b82f6);
  --bg: #f1f5f9;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --success: #16a34a;
  --warning: #f59e0b;
  --danger: #ef4444;
  --radius: 18px;
  --shadow-sm: 0 4px 10px rgba(15, 23, 42, 0.05);
  --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 20px 45px rgba(15, 23, 42, 0.12);
  --transition: all 0.3s ease;
}

[data-bs-theme="dark"] {
  --bg: #020617;
  --card: #0f172a;
  --text: #f8fafc;
  --muted: #94a3b8;
  --border: #1e293b;
  --sidebar-bg: #020617;
  --sidebar-bg-2: #0f172a;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: "Poppins", sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow-x: hidden;
  transition: var(--transition);
}

/* --- PURE CSS RESPONSIVE SIDEBAR ENGINE --- */
#sidebar-checkbox {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.wrapper { display: flex; width: 100%; min-height: 100vh; position: relative; }

.sidebar {
  width: 280px;
  height: 100vh;
  position: fixed;
  left: 0;
  top: 0;
  z-index: 1050;
  overflow-y: auto;
  background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg-2) 100%);
  border-right: 1px solid rgba(255,255,255,0.05);
  transition: var(--transition);
  box-shadow: var(--shadow-lg);
}
.sidebar::-webkit-scrollbar { width: 6px; }
.sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 20px; }

.content {
  flex: 1; margin-left: 280px; display: flex; flex-direction: column;
  min-height: 100vh; transition: var(--transition);
}

/* Desktop behaviors when toggle is clicked (Collapse Sidebar) */
@media (min-width: 993px) {
  #sidebar-checkbox:checked ~ .wrapper .sidebar {
    transform: translateX(-280px);
  }
  #sidebar-checkbox:checked ~ .wrapper .content {
    margin-left: 0;
  }
}

/* Mobile responsive styles overrides */
@media (max-width: 992px) {
  .sidebar { 
    transform: translateX(-280px); 
  }
  .content { 
    margin-left: 0 !important; 
  }
  .main-content { 
    padding: 1.2rem; 
  }

  /* Show sidebar when checkbox is checked on mobile */
  #sidebar-checkbox:checked ~ .wrapper .sidebar {
    transform: translateX(0);
  }

  /* Overlay Backdrop layer on mobile */
  .sidebar-backdrop {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.4); z-index: 1040; 
    display: none; cursor: pointer;
  }
  #sidebar-checkbox:checked ~ .wrapper .sidebar-backdrop {
    display: block;
  }
}
/* ----------------------------------------- */

.sidebar-header { padding: 28px 22px 20px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.brand-logo {
  width: 70px; height: 70px; margin: auto; border-radius: 22px;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 15px 30px rgba(37,99,235,0.35);
}
.brand-logo i { font-size: 2rem; color: white; }
.brand-text { color: white; font-weight: 700; font-size: 1.15rem; letter-spacing: 1px; }

.sidebar-user {
  margin: 18px 16px; padding: 14px; border-radius: 18px;
  background: rgba(255,255,255,0.04); backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.04);
}
.sidebar-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.15); }
.sidebar-avatar-placeholder {
  width: 52px; height: 52px; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex; align-items: center; justify-content: center;
}
.sidebar-avatar-placeholder i { color: white; font-size: 1.4rem; }
.sidebar-user h6 { color: white; font-size: 0.95rem; margin-bottom: 4px; }
.sidebar-user p { color: #94a3b8; font-size: 0.82rem; margin: 0; }
.sidebar-divider { height: 1px; margin: 18px 16px; background: rgba(255,255,255,0.08); }

.sidebar-menu { list-style: none; padding: 0 14px 25px; margin: 0; }
.sidebar-menu li { margin-bottom: 8px; }
.sidebar-link {
  display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 16px;
  color: #cbd5e1; text-decoration: none; font-size: 0.95rem; font-weight: 500;
  transition: var(--transition); position: relative;
}
.sidebar-link i { font-size: 1.15rem; min-width: 22px; }
.sidebar-link:hover { background: var(--sidebar-hover); color: white; transform: translateX(4px); }
.sidebar-link.active {
  background: var(--sidebar-active); color: white;
  box-shadow: 0 12px 25px rgba(37,99,235,0.28);
}
.logout-link { background: rgba(239,68,68,0.08); color: #fca5a5; }
.logout-link:hover { background: linear-gradient(135deg, #dc2626, #ef4444); color: white; }

.top-navbar {
  background: rgba(255,255,255,0.75); backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border); padding: 1rem 1.5rem;
  display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 999;
}
[data-bs-theme="dark"] .top-navbar { background: rgba(15,23,42,0.85); }

.toggle-btn {
  width: 44px; height: 44px; border: none; outline: none; border-radius: 14px;
  background: transparent; display: flex; align-items: center; justify-content: center;
  color: var(--text); font-size: 1.35rem; transition: var(--transition); cursor: pointer;
  user-select: none;
}
.toggle-btn:hover { background: rgba(37,99,235,0.08); color: var(--primary); }

.main-content { padding: 2rem; flex: 1; }

.card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow);
  overflow: hidden; transition: var(--transition);
}
.card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
.card-body { padding: 1.5rem; }
.card-header {
  background: transparent; border-bottom: 1px solid var(--border);
  padding: 1rem 1.5rem; font-weight: 600;
}

.btn {
  border-radius: 12px; font-weight: 600; transition: var(--transition);
}
.btn:hover { transform: translateY(-2px); }
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border: none; box-shadow: 0 8px 20px rgba(37,99,235,0.25);
}
.btn-primary:hover {
  background: linear-gradient(135deg, var(--primary-dark), var(--primary));
}

.avatar-sm { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.15); }

.notification-menu { width: 340px; border-radius: 15px; overflow: hidden; animation: fadeIn .3s ease; }
.notification-body { max-height: 400px; overflow-y: auto; }
.notification-item { transition: all .2s ease; }
.notification-item:hover { background: rgba(37,99,235,0.03); }
.notification-item.unread { background: rgba(37,99,235,0.05); }
.notification-icon { width: 38px; height: 38px; display:flex; align-items:center; justify-content:center; font-size:14px; }
@keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

.mini-icon {
  width: 55px; height: 55px; border-radius: 16px; display: flex;
  align-items: center; justify-content: center; background: rgba(37, 99, 235, 0.1);
}
.mini-icon i { font-size: 1.4rem; color: var(--primary); }

.info-box {
  display: flex; align-items: flex-start; gap: 15px; padding: 18px;
  border-radius: 18px; background: rgba(148, 163, 184, 0.06); transition: 0.3s ease;
}
.info-box:hover { transform: translateY(-3px); background: rgba(37,99,235,0.06); }
.info-icon {
  width: 52px; height: 52px; border-radius: 16px; display: flex;
  align-items: center; justify-content: center; background: rgba(37, 99, 235, 0.12); flex-shrink: 0;
}
.info-icon i { color: var(--primary); font-size: 1.2rem; }
.info-icon.success { background: rgba(22, 163, 74, 0.12); }
.info-icon.success i { color: var(--success); }
.info-icon.danger { background: rgba(239, 68, 68, 0.12); }
.info-icon.danger i { color: var(--danger); }
.info-icon.warning { background: rgba(245, 158, 11, 0.12); }
.info-icon.warning i { color: var(--warning); }

.section-badge {
  display: inline-flex; align-items: center; padding: 10px 16px;
  border-radius: 50px; background: rgba(37, 99, 235, 0.08);
  color: var(--primary); font-weight: 600; font-size: 0.92rem;
}

.empty-state { padding: 4rem 1rem; text-align: center; }
.empty-state i { font-size: 4rem; color: var(--muted); opacity: 0.5; margin-bottom: 1rem; }

.footer {
  background: var(--card); border-top: 1px solid var(--border);
  padding: 1.2rem; text-align: center; color: var(--muted);
}

/* KPI Icon Colors - force visibility */
.mini-icon.success-icon {
  background: rgba(22, 163, 74, 0.18) !important;
}
.mini-icon.success-icon i {
  color: #16a34a !important;
  font-size: 1.5rem !important;
  opacity: 1 !important;
}

.admissions-icon {
  width: 58px !important;
  height: 58px !important;
  border-radius: 16px !important;
  background: #16a34a !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.admissions-icon i.bi-bed-fill {
  font-size: 1.8rem !important;
  color: #ffffff !important;
  line-height: 1 !important;
  opacity: 1 !important;
  display: inline-block !important;
}

.admissions-subtext {
  color: #16a34a !important;
  font-weight: 600 !important;
  font-size: 0.85rem !important;
}

.admissions-dot {
  width: 7px;
  height: 7px;
  background: #16a34a;
  border-radius: 50%;
  display: inline-block;
  margin-right: 5px;
}

.hms-gradient-header {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
    color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .hms-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hms-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
  }
  .icon-circle-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }
  .hms-table thead {
    background: #f8fafc;
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .hms-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .hms-action-btn:hover {
    transform: translateY(-2px);
  }
  .hms-badge-active {
    background-color: rgba(16, 185, 129, 0.15) !important;
    color: #047857 !important;
    font-weight: 600;
  }
  .hms-badge-discharged {
    background-color: rgba(100, 116, 139, 0.15) !important;
    color: #475569 !important;
    font-weight: 600;
  }
  .doctor-dashboard {
            padding: 1.5rem;
        }

        .doctor-welcome {
            background: linear-gradient(135deg, #9191e7, #2563eb);
            color: white;
            border-radius: 18px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 25px rgba(30, 64, 175, 0.15);
        }

        .doctor-welcome h2 {
            font-weight: 700;
            margin-bottom: .4rem;
        }

        .doctor-welcome p {
            margin-bottom: 0;
            opacity: .9;
        }

        .doctor-stat-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 1.25rem;
            height: 100%;
            transition: all .2s ease;
            box-shadow: 0 4px 12px rgba(0,0,0,.04);
        }

        .doctor-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

        .doctor-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 1rem;
            background: #eff6ff;
            color: #2563eb;
        }

        .doctor-stat-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: #111827;
        }

        .doctor-stat-label {
            color: #6b7280;
            font-size: .9rem;
        }

        .doctor-section {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            margin-top: 1.5rem;
            overflow: hidden;
            box-shadow: 0 4px 12px rgba(0,0,0,.04);
        }

        .doctor-section-header {
            padding: 1.2rem 1.4rem;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .doctor-section-header h5 {
            margin: 0;
            font-weight: 700;
            color: #111827;
        }

        .doctor-table th {
            font-size: .78rem;
            text-transform: uppercase;
            color: #6b7280;
            font-weight: 600;
            padding: 1rem;
            white-space: nowrap;
        }

        .doctor-table td {
            padding: 1rem;
            vertical-align: middle;
        }

        .patient-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #eff6ff;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-right: .6rem;
        }

        .doctor-action-btn {
            border-radius: 9px;
            font-size: .82rem;
        }

        .quick-action {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 1.2rem;
            text-decoration: none;
            color: #111827;
            display: block;
            height: 100%;
            transition: all .2s ease;
            background: white;
        }

        .quick-action:hover {
            border-color: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(37, 99, 235, .10);
            color: #2563eb;
        }

        .quick-action i {
            font-size: 1.5rem;
            margin-bottom: .7rem;
            display: block;
            color: #2563eb;
        }

        .empty-doctor-state {
            padding: 3rem 1rem;
            text-align: center;
            color: #6b7280;
        }

/* RESPONSIVE LAYOUT OVERRIDES 2026 */

/* Prevent dashboard children from forcing horizontal page overflow */
.wrapper,
.content,
.main-content,
.doctor-dashboard,
.row > * {
    min-width: 0;
}

img,
video,
iframe {
    max-width: 100%;
}

/* Tablets and smaller screens */
@media (max-width: 992px) {
    .main-content {
        padding: 1.2rem;
    }

    .top-navbar {
        padding: .85rem 1rem;
        gap: .75rem;
    }

    .notification-menu {
        width: min(340px, calc(100vw - 1.5rem));
        max-width: calc(100vw - 1.5rem);
    }

    .doctor-dashboard {
        padding: .75rem;
    }

    .doctor-welcome {
        padding: 1.5rem;
    }

    .doctor-section-header {
        flex-wrap: wrap;
        gap: .75rem;
    }

    .card-body {
        padding: 1.2rem;
    }

    .hms-gradient-header {
        padding: 1.5rem;
    }

    .table-responsive {
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
}

/* Phones */
@media (max-width: 576px) {
    .main-content {
        padding: .85rem;
    }

    .top-navbar {
        padding: .7rem .75rem;
        gap: .5rem;
    }

    .top-navbar > .d-flex {
        gap: .5rem !important;
        min-width: 0;
    }

    .toggle-btn {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    .notification-menu {
        width: calc(100vw - 1rem);
        max-width: calc(100vw - 1rem);
    }

    .doctor-dashboard {
        padding: 0;
    }

    .doctor-welcome {
        padding: 1.2rem;
        border-radius: 14px;
    }

    .doctor-welcome h2 {
        font-size: 1.35rem;
    }

    .doctor-stat-number {
        font-size: 1.5rem;
    }

    .doctor-section-header {
        padding: 1rem;
    }

    .doctor-table th,
    .doctor-table td {
        padding: .7rem;
    }

    .card-body {
        padding: 1rem;
    }

    .card-header {
        padding: .85rem 1rem;
    }

    .hms-gradient-header {
        padding: 1.2rem;
    }

    .info-box {
        gap: 10px;
        padding: 1rem;
    }

    .empty-state {
        padding: 2.5rem .75rem;
    }

    .empty-state i {
        font-size: 3rem;
    }

    input,
    select,
    textarea,
    .form-control,
    .form-select {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .dropdown-menu {
        max-width: calc(100vw - 1rem);
    }
}

/* Very narrow phones */
@media (max-width: 360px) {
    .main-content {
        padding: .65rem;
    }

    .top-navbar {
        padding: .6rem;
    }

    .doctor-welcome h2 {
        font-size: 1.2rem;
    }

    .card-body {
        padding: .85rem;
    }
}
</style>
</head>
<body>

<!-- Hidden switch checkbox for pure CSS toggle states -->
<input type="checkbox" id="sidebar-checkbox">
  
<div class="wrapper">
  <!-- Mobile Backdrop Overlay configured as a functional label -->
  <label for="sidebar-checkbox" class="sidebar-backdrop"></label>

  <!-- SIDEBAR -->
  <nav class="sidebar shadow-lg" id="sidebar">
    <!-- Logo / Brand -->
    <div class="sidebar-header text-center">
      <div class="brand-logo mb-3">
        <i class="bi bi-heart-pulse-fill"></i>
      </div>
      <h4 class="brand-text">LIFESPRING</h4>
      <small class="text-light opacity-75">Medical Center</small>
    </div>

    {% if user.is_authenticated %}
    <!-- User Info -->
    
   
<!-- Navigation -->
<ul class="sidebar-menu">

  <!-- Dashboard (Accessible to All Authenticated Users) -->
  <li>
    <a href="{% url 'dashboard' %}" class="sidebar-link {% if page == 'dashboard' %}active{% endif %}">
      <i class="bi bi-speedometer2"></i>
      <span>Dashboard</span>
    </a>
  </li>

  <!-- ==================== ADMIN & MEDICAL STAFF ==================== -->
  {% if role in 'admin,doctor,nurse,receptionist' %}
  <li>
    <a href="{% url 'dashboard' %}?page=patients" class="sidebar-link {% if page == 'patients' %}active{% endif %}">
      <i class="bi bi-people"></i>
      <span>Patients</span>
    </a>
  </li>

  <li>
    <a href="{% url 'dashboard' %}?page=appointments" class="sidebar-link {% if page == 'appointments' %}active{% endif %}">
      <i class="bi bi-calendar-check"></i>
      <span>Appointments</span>
    </a>
  </li>

  <li>
    <a href="{% url 'dashboard' %}?page=admissions" class="sidebar-link {% if page == 'admissions' %}active{% endif %}">
      <i class="bi bi-building"></i>
      <span>Admissions</span>
    </a>
  </li>
  {% endif %}

  <!-- ==================== CLINICAL RECORDS (Doctors, Nurses, Admin) ==================== -->
  {% if role in 'admin,doctor,nurse,receptionist' %}
  <li>
    <a href="{% url 'dashboard' %}?page=medical_records" class="sidebar-link {% if page == 'medical_records' %}active{% endif %}">
      <i class="bi bi-file-medical"></i>
      <span>Medical Records</span>
    </a>
  </li>
  {% endif %}

  <!-- ==================== PRESCRIPTIONS (Doctors, Pharmacists, Admin) ==================== -->
  {% if role in 'admin,doctor,pharmacist,receptionist' %}
  <li>
    <a href="{% url 'dashboard' %}?page=prescriptions" class="sidebar-link {% if page == 'prescriptions' %}active{% endif %}">
      <i class="bi bi-capsule"></i>
      <span>Prescriptions</span>
    </a>
  </li>
  {% endif %}

  <!-- ==================== PHARMACY (Pharmacists, Admin) ==================== -->
  {% if role in 'admin,pharmacist,receptionist' %}
  <li>
    <a href="{% url 'dashboard' %}?page=pharmacy" class="sidebar-link {% if page == 'pharmacy' %}active{% endif %}">
      <i class="bi bi-prescription2"></i>
      <span>Pharmacy</span>
    </a>
  </li>
  {% endif %}

  <!-- ==================== LABORATORY (Lab Techs, Doctors, Admin) ==================== -->
  {% if role in 'admin,doctor,lab_tech,receptionist' %}
  <li>
    <a href="{% url 'dashboard' %}?page=laboratory" class="sidebar-link {% if page == 'laboratory' %}active{% endif %}">
      <i class="bi bi-eyedropper"></i>
      <span>Laboratory</span>
    </a>
  </li>
  {% endif %}

  <!-- ==================== BILLING / INVOICES (Admin, Accountant, Receptionist) ==================== -->
  {% if role in 'admin,accountant,receptionist' %}
  <li>
