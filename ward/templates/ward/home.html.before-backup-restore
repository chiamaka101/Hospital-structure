                        {% elif apt.status == 'completed' %}
                          <span class="badge rounded-pill px-3 py-2" style="background: rgba(22,163,74,0.12); color: var(--success);">{{ apt.status|title }}</span>
                        {% else %}
                          <span class="badge rounded-pill px-3 py-2" style="background: rgba(245,158,11,0.12); color: var(--warning);">{{ apt.status|title }}</span>
                        {% endif %}
                      </div>
                      <div class="flex-shrink-0" style="width: 85px;">
                        <a href="{% url 'dashboard' %}?page=edit_appointment&id={{ apt.id }}" class="btn btn-sm btn-outline-primary rounded-3 w-100"><i class="bi bi-eye"></i></a>
                      </div>
                    </div>
                    {% endfor %}
